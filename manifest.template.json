{
  "manifest_version": 3,
  "name": "Awesome bookmarks",
  "version": "1.5.0",
  "description": "Your bookmarks as an app drawer on every new tab.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "search"
  ],
  "optional_permissions": [
    "history",
    "topSites",
    "identity"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events.readonly"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}